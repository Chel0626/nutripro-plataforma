# NutriPro V2 Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://nutripro:password@localhost/nutripro_nutrition
POSTGRES_DB=nutripro_nutrition
POSTGRES_USER=nutripro
POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379

# API URLs
NUTRITION_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Development
DEBUG=true
NODE_ENV=development

# Security (change in production)
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-key-change-in-production

# External APIs (when implemented)
OPENAI_API_KEY=your-openai-key
PAGSEGURO_TOKEN=your-pagseguro-token
NFE_CERTIFICATE_PATH=/path/to/certificate.p12