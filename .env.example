# .env - Variáveis de ambiente (não subir para o GitHub)
# Copie este arquivo e configure suas variáveis

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration (opcional - usar SQLite local se não configurado)
DATABASE_URL=sqlite:///nutripro.db

# Firebase Configuration (para deploy cloud)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"seu-projeto-id",...}

# Google Calendar (opcional - configure depois)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (opcional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=